{
  "name": "Fraud Email Detection | Gmail to review, summary & reporting",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {}
      },
      "id": "gmail-trigger",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        200,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => { const e=item.json; const headers=e.payload?.headers || []; const h=n=>headers.find(v=>v.name?.toLowerCase()===n)?.value || ''; return {json:{message_id:e.id || e.messageId || '',sender:e.from || h('from'),recipient:e.to || h('to'),subject:e.subject || h('subject'),body:e.textPlain || e.text || e.snippet || '',company_context:$env.COMPANY_CONTEXT || 'operations'}};});"
      },
      "id": "extract-sender-receiver-subject-body",
      "name": "Extract sender receiver subject body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({json:{...item.json,_original:{...item.json}}}));"
      },
      "id": "preserve-original-fields",
      "name": "Preserve original fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        350
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FRAUD_TRIAGE_API_URL || 'http://host.docker.internal:8000/triage'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fraud-phishing-analysis",
      "name": "Fraud phishing analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        860,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => { const j=item.json; const source=$('Preserve original fields').first().json; const risk=j.risk_score ?? 0; const band=risk>=0.65?'high':risk>=0.25?'medium':'low'; const suspicious=['fraud','phishing','needs_review'].includes(j.label);return {json:{...source,...j,suspicion_level:band,suspicious,security_review:suspicious,reply_needed:suspicious?false:!!j.reply_needed}};});"
      },
      "id": "suspicion-low-medium-high",
      "name": "Suspicion low medium high",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        350
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "condition-suspicious-email",
              "leftValue": "={{$json.suspicious === true}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "suspicious-email",
      "name": "Suspicious email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1300,
        350
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,route:'security_review',automatic_reply:false,security_action:'human review - do not click links or send funds'}}));"
      },
      "id": "security-review",
      "name": "Security review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,route:'other_email',automatic_reply:false}}));"
      },
      "id": "other-emails",
      "name": "Other emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        520
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "condition-company-relevance-assessment",
              "leftValue": "={{$json.relevant === true}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "company-relevance-assessment",
      "name": "Company relevance assessment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1750,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,company_relevance:'relevant',business_priority:$json.priority==='critical'?'urgent':$json.priority==='high'?'high':'normal',business_urgency_note:'Business urgency requires verification; security risk priority is not a business SLA.'}}));"
      },
      "id": "email-priority-classification",
      "name": "Email priority classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,company_relevance:'irrelevant_or_unknown',business_priority:'low',reply_needed:false}}));"
      },
      "id": "irrelevant-email-queue",
      "name": "Irrelevant email queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        690
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "condition-urgent-business-email",
              "leftValue": "={{$json.business_priority === 'urgent' || $json.business_priority === 'high'}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "urgent-business-email",
      "name": "Urgent business email",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2210,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,route:'urgent_business_human_review',automatic_reply:false}}));"
      },
      "id": "urgent-email-review",
      "name": "Urgent email review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        310
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,route:'legitimate_business_review',automatic_reply:false}}));"
      },
      "id": "legitimate-email-review",
      "name": "Legitimate email review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        540
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FRAUD_SUMMARY_API_URL || 'http://host.docker.internal:8000/assistant/summarize'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({message_id:$json.message_id,sender:$json.sender,recipient:$json.recipient,subject:$json.subject,body:$json.body,company_context:$json.company_context})}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "generate-short-summary",
      "name": "AI chatbot summarization API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2670,
        440
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "condition-reply-necessary",
              "leftValue": "={{$json.reply_needed === true && $json.label === 'legitimate'}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "reply-necessary",
      "name": "Reply necessary",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2890,
        440
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,draft_reply:$json.proposed_reply||'Thank you for your email. Our team will review your request.',approval_status:'pending',automatic_reply:false}}));"
      },
      "id": "prepare-draft-reply",
      "name": "Prepare draft reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,approval_status:'required',send_allowed:false,automatic_reply:false}}));"
      },
