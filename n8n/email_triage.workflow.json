{
  "name": "Fraud email triage - draft only",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {}
      },
      "id": "gmail",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        220,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => ({json:{message_id:item.json.id || '',sender:item.json.from || '',recipient:item.json.to || '',subject:item.json.subject || '',body:item.json.textPlain || item.json.snippet || '',company_context:$env.COMPANY_CONTEXT || 'operations'}}));"
      },
      "id": "shape",
      "name": "Normalize metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.FRAUD_TRIAGE_API_URL || 'http://host.docker.internal:8000/triage'}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "classify",
      "name": "Triage via FastAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "r",
              "leftValue": "={{$json.reply_needed}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            },
            {
              "id": "s",
              "leftValue": "={{$json.review_required}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "gate",
      "name": "Human review queue",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,action:'review_draft_only',automatic_send:false}}));"
      },
      "id": "draft",
      "name": "Queue suggested draft for approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,action:'log_and_review',automatic_send:false}}));"
      },
      "id": "log",
      "name": "Log no-auto-reply decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        410
      ]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Normalize metadata",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize metadata": {
      "main": [
        [
          {
            "node": "Triage via FastAPI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triage via FastAPI": {
      "main": [
        [
          {
            "node": "Human review queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Human review queue": {
      "main": [
        [
          {
            "node": "Queue suggested draft for approval",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log no-auto-reply decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false
}