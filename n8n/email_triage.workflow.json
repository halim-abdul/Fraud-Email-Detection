      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,approval_status:'no_reply_recommended',automatic_reply:false}}));"
      },
      "id": "no-reply-needed",
      "name": "No reply needed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>{const j=item.json; const summary=Array.isArray(j.summary_bullets)?j.summary_bullets.join(' | '):Array.isArray(j.summary)?j.summary.join(' | '):''; return {json:{message_id:j.message_id||'',sender:j.sender||'',recipient:j.recipient||'',subject:j.subject||'',label:j.label||'',suspicion_level:j.suspicion_level||'',priority:j.business_priority||j.priority||'',company_relevance:j.company_relevance||'',reply_needed:!!j.reply_needed,review_required:true,summary,route:j.route||'',approval_status:j.approval_status||'review_required',automatic_reply:false}};});"
      },
      "id": "excel-csv-report-rows",
      "name": "Excel CSV report rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3570,
        450
      ]
    },
    {
      "parameters": {
        "jsCode": "return items.map(item=>({json:{...item.json,export_ready:true,note:'Connect an approved CSV/XLSX writer or protected storage destination; no credentials stored in Git.'}}));"
      },
      "id": "export-queue-handoff",
      "name": "Export queue handoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3800,
        450
      ]
    },
    {
