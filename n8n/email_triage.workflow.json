        440
      ],
      "parameters": {
        "jsCode": "return items.map(item=>{const base=$('Email priority classification').first().json;return {json:{...base,summary_bullets:item.json.bullets||base.summary||[],summary_mode:item.json.mode||'offline_rules',assistant_mode:item.json.mode||'offline_rules',automatic_reply:false}};});"
      }
    }
