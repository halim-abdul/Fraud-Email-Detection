# Keep this file illustrative; use private local .env or a secrets manager.
FRAUD_API_KEY=replace_with_a_long_random_secret
FRAUD_API_URL=http://127.0.0.1:8000
FRAUD_TRIAGE_API_URL=http://host.docker.internal:8000/triage
FRAUD_SUMMARY_API_URL=http://host.docker.internal:8000/assistant/summarize
COMPANY_CONTEXT=Acme procurement and support

# External AI summarization is OFF by default and subject to explicit privacy approval.
FRAUD_ENABLE_EXTERNAL_LLM=0
FRAUD_LLM_PRIVACY_APPROVED=0
